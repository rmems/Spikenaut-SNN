*.png filter=lfs diff=lfs merge=lfs -text
assets/fpga_hardware_cat.jpg filter=lfs diff=lfs merge=lfs -text

# FPGA $readmemh images are logical LF hex-word files. Keep them LF so a
# Windows core.autocrlf checkout does not rewrite the bytes; the verifier
# also hashes after CRLF→LF so the pin matches either working-copy form.
*.mem text eol=lf
