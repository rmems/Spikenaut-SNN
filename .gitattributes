*.png filter=lfs diff=lfs merge=lfs -text
assets/fpga_hardware_cat.jpg filter=lfs diff=lfs merge=lfs -text

# FPGA memory images are line-ending sensitive to tooling and are pinned by
# tools/verify_q88.py. Force LF so a Windows checkout (core.autocrlf) cannot
# materialize CRLF and change the bytes of a semantically identical artifact.
*.mem text eol=lf
