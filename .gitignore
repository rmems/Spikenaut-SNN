# Rust
/target/
**/*.rs.bk

# Python
# tools/verify_q88.py is importable, so running or importing it writes bytecode
# next to the source. Never tracked.
__pycache__/
*.py[cod]
.pytest_cache/
# Local virtual environments (.agents/setup creates /.venv/)
.venv/
venv/

# Julia
# tools/anticipation/Manifest.toml is checked in on purpose (it pins the
# trainer environment CI instantiates), so only per-machine output is ignored.
*.jl.cov
*.jl.*.cov
*.jl.mem
LocalPreferences.toml

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Debug
*.log

# Coverage reports
lcov.info
*.profraw
*.profdata
coverage/

# Agent notes
docs/reseach/

# Local env overrides (contributors create their own, never tracked)
.env.local

# Generated per-run artifacts
/artifacts/*
!/artifacts/.gitkeep

# Default tools/replay_frozen.py output (untracked so reruns stay deterministic)
/replay_out/

# Default tools/recurrence_eval.py output (same reason)
/recurrence_out/

# GitHub Actions runner
/actions-runner/

# Beads / Dolt files (added by bd init)
.beads/
.dolt/
*.db
.beads-credential-key

# IDE/AI tool dirs
.mimocode/
.opencode/
.hermes/
.kilo/
.zed/
.ai/
.junie/
.claude/
# The Cursor Cloud Agent environment (.cursor/Dockerfile, .cursor/environment.json)
# is tracked; anything else Cursor writes there is local.
.cursor/*
!.cursor/Dockerfile
!.cursor/environment.json

# Agent skills & MCP servers
.swarm/

# Codacy results
codacy-results.sarif
